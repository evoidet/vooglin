{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vooglin.ee"
        }
      ],
      "destination": "https://vooglin.ee/:path*",
      "permanent": true
    }
  ]
}
